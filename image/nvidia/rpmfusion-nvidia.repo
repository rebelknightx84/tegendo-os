# RPM Fusion nonfree, scoped to NVIDIA packages only.
#
# The one exception to "official Fedora repos only". It exists only in the
# throwaway nvidia-kmod build stage (build-kmod.sh), which downloads the driver
# packages once; the finished image has no RPM Fusion repo and never pulls from it.
#
# Trust anchor: RPM Fusion's signing key from Fedora's own
# distribution-gpg-keys package, so the key itself arrives through Fedora.
# includepkgs limits this repo to package names containing "nvidia".
# minrate/timeout: drop a mirror that's slower than 256 KiB/s for 30 s and try
# the next one (a 30 KiB/s mirror once cost a build 75 minutes).

[tos-rpmfusion-nonfree]
name=RPM Fusion nonfree $releasever (NVIDIA only, build time)
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-$releasever&arch=$basearch
enabled=1
gpgcheck=1
gpgkey=file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-nonfree-fedora-$releasever
includepkgs=*nvidia*
minrate=262144
timeout=30

[tos-rpmfusion-nonfree-updates]
name=RPM Fusion nonfree $releasever updates (NVIDIA only, build time)
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-updates-released-$releasever&arch=$basearch
enabled=1
gpgcheck=1
gpgkey=file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-nonfree-fedora-$releasever
includepkgs=*nvidia*
minrate=262144
timeout=30
