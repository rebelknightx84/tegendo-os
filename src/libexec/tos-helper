#!/usr/bin/bash
# =============================================================================
# tos-helper — the ONLY code Friday can run as root. Invoked via pkexec, so
# polkit asks the person for their password every time (no caching).
#
#   tos-helper update                bootc upgrade (staged; applies on reboot)
#   tos-helper restart <unit>        systemctl restart (a few units refused)
#   tos-helper nvidia-pm on|off      NVIDIA runtime power management
#
# On tegendo-os (Fedora Atomic) the OS itself is an image: updates are staged
# as a new deployment and the previous one stays bootable, so `tos undo`
# (bootc rollback) is always available. /etc edits are backed up first.
# Every action is logged to the journal (tag: tos-helper), out of the AI's
# reach. The last line of output is a JSON summary for tos-mcp. Arguments are
# re-validated here: the caller is never trusted.
# =============================================================================
set -euo pipefail
export PATH=/usr/sbin:/usr/bin
export LC_ALL=C
umask 022

ACTION=${1:-}
shift || true
CALLER=${PKEXEC_UID:-unknown}
UNIT_RE='^[A-Za-z0-9][A-Za-z0-9@._:\\-]{0,127}\.(service|socket|timer|target|path|mount)$'
# Restarting these logs you out or breaks authentication mid-session.
REFUSED_UNITS=(systemd-logind.service display-manager.service cosmic-greeter.service
               dbus.service dbus-broker.service polkit.service systemd-journald.service)
NVIDIA_CONF=/etc/modprobe.d/tos-nvidia-pm.conf
BACKUP_DIR=/var/lib/tegendo-os/backup

summary() {  # summary <rc> [staged-digest] [backup]
  printf '{"action":"%s","rc":%d,"staged":%s,"backup":%s}\n' "$ACTION" "$1" \
    "$( [[ -n ${2:-} ]] && printf '"%s"' "$2" || echo null)" \
    "$( [[ -n ${3:-} ]] && printf '"%s"' "$3" || echo null)"
}
fail() { echo "tos-helper: $*" >&2; logger -t tos-helper "uid=$CALLER action=$ACTION refused: $*"; summary 2; exit 2; }

[[ $EUID -eq 0 ]] || { echo "tos-helper: must run via pkexec" >&2; exit 1; }

# ---- validate before touching anything ---------------------------------------
case "$ACTION" in
  update)
    (( $# == 0 )) || fail "update takes no arguments"
    ;;
  restart)
    (( $# == 1 )) || fail "restart takes one unit"
    [[ $1 =~ $UNIT_RE ]] || fail "invalid unit name"
    for u in "${REFUSED_UNITS[@]}"; do [[ $1 != "$u" ]] || fail "restarting $1 is not allowed from Friday"; done
    ;;
  nvidia-pm)
    (( $# == 1 )) && [[ $1 == on || $1 == off ]] || fail "nvidia-pm takes on|off"
    ;;
  *) fail "unknown action '${ACTION}'" ;;
esac

[[ -e /run/ostree-booted ]] || fail "not an ostree/bootc system; refusing"
logger -t tos-helper "uid=$CALLER action=$ACTION args=$* starting"

# ---- act ----------------------------------------------------------------------
staged="" backup=""
set +e
case "$ACTION" in
  update)
    bootc upgrade
    rc=$?
    staged=$(bootc status --format=json 2>/dev/null | jq -r '.status.staged.image.imageDigest // empty')
    [[ -n $staged ]] && echo "Update staged. Reboot to apply; the current system stays bootable."
    [[ -z $staged && $rc -eq 0 ]] && echo "Already up to date."
    ;;
  restart)
    systemctl restart -- "$1" && systemctl is-active -- "$1"
    rc=$?
    ;;
  nvidia-pm)
    install -d -m700 "$BACKUP_DIR"
    backup="$BACKUP_DIR/tos-nvidia-pm.conf.$(date +%Y%m%dT%H%M%S)"
    if [[ -f $NVIDIA_CONF ]]; then cp -a -- "$NVIDIA_CONF" "$backup"; else : >"$backup.absent"; backup="$backup.absent"; fi
    if [[ $1 == on ]]; then
      printf '# Managed by tegendo-os (Friday). Lets the NVIDIA GPU power down when idle.\noptions nvidia NVreg_DynamicPowerManagement=0x02\n' >"$NVIDIA_CONF"
    else
      rm -f -- "$NVIDIA_CONF"
    fi
    rc=$?
    echo "Reboot to apply. Previous state saved to $backup."
    ;;
esac
set -e

logger -t tos-helper "uid=$CALLER action=$ACTION args=$* rc=$rc staged=${staged:-none} backup=${backup:-none}"
summary "$rc" "$staged" "$backup"
exit "$rc"
