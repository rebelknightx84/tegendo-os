#!/usr/bin/bash
# =============================================================================
# tos-helper — the ONLY code Friday can run as root. Invoked via pkexec, so
# polkit asks the person for their password every time (no caching).
#
#   tos-helper install <pkg>...      pacman -S --needed (official repos only)
#   tos-helper update                pacman -Syu
#   tos-helper restart <unit>        systemctl restart (a few units refused)
#   tos-helper nvidia-pm on|off      NVIDIA runtime power management
#
# Every action runs between a Snapper pre/post snapshot pair and is logged to
# the journal (tag: tos-helper), where the AI can't edit it. The last line of
# output is a JSON summary for tos-mcp. Arguments are re-validated here: the
# caller is never trusted, even though tos-mcp validates too.
# =============================================================================
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
export LC_ALL=C
umask 022

ACTION=${1:-}
shift || true
CALLER=${PKEXEC_UID:-unknown}
PKG_RE='^[a-z0-9@._+][a-z0-9@._+-]{0,99}$'
UNIT_RE='^[A-Za-z0-9][A-Za-z0-9@._:\\-]{0,127}\.(service|socket|timer|target|path|mount)$'
# Restarting these logs you out or breaks authentication mid-session.
REFUSED_UNITS=(systemd-logind.service display-manager.service cosmic-greeter.service
               dbus.service dbus-broker.service polkit.service systemd-journald.service)
NVIDIA_CONF=/etc/modprobe.d/tos-nvidia-pm.conf

summary() {  # summary <rc> [pre] [post]
  printf '{"action":"%s","rc":%d,"pre":%s,"post":%s}\n' "$ACTION" "$1" "${2:-null}" "${3:-null}"
}
fail() { echo "tos-helper: $*" >&2; logger -t tos-helper "uid=$CALLER action=$ACTION refused: $*"; summary 2; exit 2; }

[[ $EUID -eq 0 ]] || { echo "tos-helper: must run via pkexec" >&2; exit 1; }

# ---- validate before touching anything ---------------------------------------
desc=""
case "$ACTION" in
  install)
    (( $# >= 1 && $# <= 10 )) || fail "install takes 1-10 packages"
    for p in "$@"; do [[ $p =~ $PKG_RE ]] || fail "invalid package name"; done
    desc="install $*"
    ;;
  update)
    (( $# == 0 )) || fail "update takes no arguments"
    desc="system update"
    ;;
  restart)
    (( $# == 1 )) || fail "restart takes one unit"
    [[ $1 =~ $UNIT_RE ]] || fail "invalid unit name"
    for u in "${REFUSED_UNITS[@]}"; do [[ $1 != "$u" ]] || fail "restarting $1 is not allowed from Friday"; done
    desc="restart $1"
    ;;
  nvidia-pm)
    (( $# == 1 )) && [[ $1 == on || $1 == off ]] || fail "nvidia-pm takes on|off"
    desc="nvidia runtime pm $1"
    ;;
  *) fail "unknown action '${ACTION}'" ;;
esac

snapper -c root get-config >/dev/null 2>&1 ||
  fail "no Snapper 'root' config, so no safety snapshot is possible; refusing"

logger -t tos-helper "uid=$CALLER action=$ACTION args=$* starting"
pre=$(snapper -c root create --type pre --print-number --cleanup-algorithm number \
        --description "friday: $desc" --userdata "tos=friday")

# ---- act ----------------------------------------------------------------------
set +e
case "$ACTION" in
  install) SNAP_PAC_SKIP=y pacman -S --needed --noconfirm -- "$@" ;;
  update)  SNAP_PAC_SKIP=y pacman -Syu --noconfirm ;;
  restart) systemctl restart -- "$1" && systemctl is-active -- "$1" ;;
  nvidia-pm)
    if [[ $1 == on ]]; then
      printf '# Managed by tegendo-os (Friday). Lets the NVIDIA GPU power down when idle.\noptions nvidia NVreg_DynamicPowerManagement=0x02\n' >"$NVIDIA_CONF"
    else
      rm -f -- "$NVIDIA_CONF"
    fi
    # Options for modules baked into the initramfs only apply after a rebuild.
    if command -v mkinitcpio >/dev/null &&
       grep -qsE '^[[:space:]]*MODULES=.*nvidia' /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf; then
      mkinitcpio -P
    fi
    echo "Reboot to apply."
    ;;
esac
rc=$?
set -e

post=$(snapper -c root create --type post --pre-number "$pre" --print-number --cleanup-algorithm number \
         --description "friday: $desc (rc=$rc)" --userdata "tos=friday")
logger -t tos-helper "uid=$CALLER action=$ACTION args=$* rc=$rc snapshots=$pre..$post"
summary "$rc" "$pre" "$post"
exit "$rc"
