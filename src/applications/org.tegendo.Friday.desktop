[Desktop Entry]
Type=Application
Name=Friday
GenericName=Tegendo OS assistant
Comment=Ask about this computer and fix things, with your approval (Alt+Space)
Exec=tos-friday --show
Icon=tegendo-logo
Terminal=false
Categories=System;
