#!/usr/bin/env bash
# =============================================================================
# tos-crash-watch — notify on crashes of YOUR processes and offer a diagnosis.
# Runs as a systemd user service (tos-crash-watch.service).
#
# Same idea as Omarchy's crash watcher: follow systemd-coredump's journal
# entries, dedupe crash loops, honour per-program mutes. Clicking "Diagnose"
# opens a terminal running `tos-doctor crash ...`, which still asks before
# sending anything anywhere.
#
#   TOS_CRASH_DEDUPE_SECONDS=60   one toast per program per window
#   TOS_CRASH_IGNORE='^(foo|bar)$' extended regex of names never announced
#   mute a program:   touch ~/.config/tegendo-os/crash-mute/<name>
# =============================================================================
set -uo pipefail

readonly COREDUMP_MESSAGE_ID=fc2e22bc6ee647b6b90729ab34a250b1   # systemd.journal-fields(7)
readonly DEDUPE=${TOS_CRASH_DEDUPE_SECONDS:-60}
readonly IGNORE=${TOS_CRASH_IGNORE:-}
readonly MUTE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tegendo-os/crash-mute"
readonly TERM_CMD=${TOS_TERMINAL:-kitty}

declare -A last

term_argv() {  # how each terminal takes a command to run
  case "${TERM_CMD##*/}" in
    kitty) printf '%s\0' "$TERM_CMD" ;;              # kitty <cmd> <args>
    *)     printf '%s\0' "$TERM_CMD" -e ;;           # ghostty/foot/cosmic-term -e <cmd>
  esac
}

offer() {  # offer <name> <pid> <exe> <signal>   (runs in background)
  local choice
  choice=$(notify-send --app-name=tegendo-os --urgency=critical --wait \
    --action=diagnose="Diagnose with AI" --action=mute="Don't show again" \
    "$1 crashed" "Signal $4 (pid $2)" 2>/dev/null) || return 0
  case "$choice" in
    # systemd-run starts the terminal as its own unit, outside this service's
    # sandbox (read-only FS, NoNewPrivileges would block the password prompt).
    diagnose)
      local -a term
      mapfile -d '' -t term < <(term_argv)
      exec systemd-run --user --quiet --collect -- "${term[@]}" tos-doctor crash "$2" "$1" "$3" "$4" ;;
    mute) mkdir -p "$MUTE_DIR" && touch "$MUTE_DIR/$1" ;;
  esac
}

# -n 0: a restart must not re-announce crashes that were already seen.
journalctl -f -n 0 -o json "MESSAGE_ID=$COREDUMP_MESSAGE_ID" 2>/dev/null |
  while IFS= read -r entry; do
    IFS=$'\t' read -r uid comm pid exe signal < <(
      jq -r 'def f: if . == null or . == "" then "-" else . end;
             [(._UID|f),(.COREDUMP_COMM|f),(.COREDUMP_PID|f),(.COREDUMP_EXE|f),(.COREDUMP_SIGNAL_NAME|f)] | @tsv' \
        <<<"$entry" 2>/dev/null)

    [[ $pid =~ ^[0-9]+$ && $uid =~ ^[0-9]+$ ]] || continue
    (( uid == UID )) || continue                 # daemons are the admin's problem

    name=$comm
    [[ $exe == /* ]] && name=${exe##*/}          # comm is truncated to 15 chars
    name=${name##*/}                             # one path component, always
    [[ -n $name && $name != - && $name != . && $name != .. ]] || name=unknown

    [[ -n $IGNORE && $name =~ $IGNORE ]] && continue
    [[ $name == tos-* ]] && continue             # never report ourselves
    [[ -e $MUTE_DIR/$name ]] && continue

    now=$EPOCHSECONDS
    (( now - ${last[$name]:-0} < DEDUPE )) && continue
    last[$name]=$now

    offer "$name" "$pid" "$exe" "$signal" &
  done
