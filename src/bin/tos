#!/usr/bin/env bash
# tos — tegendo-os command dispatcher
#
#   tos theme <list|current|set NAME>   themes (Omarchy-format, applied to COSMIC)
#   tos doctor [question]               AI-assisted health check (asks before sending)
#   tos doctor crash <pid>              AI-assisted crash diagnosis
#   tos agent "prompt"                  start your agent (never auto-approve)
#   tos update                          stage the newest OS image + update Flatpaks
#   tos undo                            boot the previous OS image (you only; Friday can't)
#   tos setup [--force]                 re-run per-user setup
#   tos status                          image, version, health summary
#   tos friday-log [n]                  what Friday did recently
#   tos mok [status|enroll]             Secure Boot key for the NVIDIA driver
set -euo pipefail

MOK_CERT=/usr/share/tegendo-os/mok/tegendo-mok.der

mok_state() {
  [[ -f $MOK_CERT ]] || { echo "no key in this image"; return; }
  # Parse mokutil's words, not its exit code (which differs across versions).
  local out
  out=$(mokutil --test-key "$MOK_CERT" 2>&1 || true)
  case $out in
    *"already in the enrollment request"*) echo "pending: reboot and finish enrollment in MOK Manager" ;;
    *"already enrolled"*) echo "enrolled" ;;
    *"not enrolled"*) echo "not enrolled (run: tos mok enroll)" ;;
    *) echo "unknown (${out%%$'\n'*})" ;;
  esac
}

case "${1:-}" in
  theme)  shift; exec tos-theme "$@" ;;
  doctor) shift; exec tos-doctor "$@" ;;
  agent)  shift; exec tos-agent "$@" ;;
  setup)  shift; exec tos-setup "$@" ;;
  update)
    echo "Checking for a new tegendo-os image..."
    sudo bootc upgrade
    echo
    echo "Updating Flatpak apps..."
    flatpak update -y --noninteractive
    if bootc status --format=json 2>/dev/null | jq -e '.status.staged != null' >/dev/null; then
      echo
      echo "A new OS image is staged. Reboot to apply; \`tos undo\` returns to this one."
    fi
    ;;
  undo)
    echo "Current deployments:"
    rpm-ostree status
    echo
    echo "This makes the previous OS image the default for the next boot."
    echo "Your home folder and Flatpaks are untouched; /etc keeps that image's version."
    read -rp "Roll back on next reboot? [y/N] " ok
    [[ $ok =~ ^[Yy]$ ]] || { echo "Nothing changed."; exit 0; }
    sudo bootc rollback
    echo "Done. Reboot to finish (run \`tos undo\` again to switch back)."
    ;;
  status)
    echo "tegendo-os $(cat /usr/share/tegendo-os/VERSION 2>/dev/null || echo '?')"
    rpm-ostree status --booted --json 2>/dev/null |
      jq -r '.deployments[0] | "image: \(.["container-image-reference"] // .origin) (\(.version // "?"))"' || true
    if [[ -f /usr/share/tegendo-os/UPSTREAM.lock ]]; then
      awk -F' = ' '$1=="ref"||$1=="commit"{printf "omarchy %s: %s\n", $1, $2}' /usr/share/tegendo-os/UPSTREAM.lock
    fi
    echo "theme: $(tos-theme current)"
    echo "agent: $(tos-agent --which)"
    echo "failed units: $(systemctl --failed --no-legend --plain | wc -l)"
    systemctl --user is-active --quiet tos-crash-watch && echo "crash watch: on" || echo "crash watch: off"
    echo "selinux: $(getenforce 2>/dev/null || echo '?')"
    if [[ -f /usr/share/tegendo-os/mok/SIGNED_WITH ]]; then
      echo "nvidia: driver $(cat /sys/module/nvidia/version 2>/dev/null || echo 'not loaded'), key $(mok_state)"
    fi
    [[ -f /var/lib/tegendo-os/flatpaks.sha256 ]] && echo "flatpak set: installed" || echo "flatpak set: pending (needs network; see systemctl status tos-flatpak-provision)"
    ;;
  mok)
    case "${2:-status}" in
      status)
        echo "secure boot: $(mokutil --sb-state 2>/dev/null || echo '?')"
        echo "nvidia key:  $(mok_state)"
        echo "modules signed with: $(cat /usr/share/tegendo-os/mok/SIGNED_WITH 2>/dev/null || echo 'n/a (no NVIDIA in this image)')"
        ;;
      enroll)
        [[ -f $MOK_CERT ]] || { echo "This image has no tegendo-os key (dev build or no NVIDIA)."; exit 1; }
        state=$(mok_state)
        [[ $state == "not enrolled"* ]] || { echo "Nothing to do: $state"; exit 0; }
        echo "This lets your firmware trust NVIDIA modules signed by your tegendo-os key."
        echo "Key fingerprint (compare with image/nvidia/tegendo-mok.der in your repo):"
        # A cert's SHA-256 fingerprint is the SHA-256 of its DER bytes (no openssl in the base image).
        sha256sum "$MOK_CERT" | cut -d' ' -f1 | tr 'a-f' 'A-F' | sed 's/../&:/g; s/:$//'
        echo
        echo "You'll pick a one-time password now and type it once after rebooting:"
        echo "  blue 'MOK management' screen -> Enroll MOK -> Continue -> Yes -> password -> Reboot."
        sudo mokutil --import "$MOK_CERT"
        echo "Done. Reboot to finish enrollment."
        ;;
      *) echo "usage: tos mok [status|enroll]"; exit 1 ;;
    esac
    ;;
  friday-log)
    log="${XDG_STATE_HOME:-$HOME/.local/state}/tegendo-os/friday/audit.jsonl"
    [[ -f $log ]] || { echo "No Friday activity yet."; exit 0; }
    tail -n "${2:-20}" "$log" |
      jq -r '[.ts[11:16], .tier, .tool, .decision, (.staged // .backup // "")] | @tsv'
    ;;
  ""|-h|--help) sed -n '2,14p' "$0" ;;
  *) echo "tos: unknown command '$1'"; sed -n '2,14p' "$0"; exit 1 ;;
esac
