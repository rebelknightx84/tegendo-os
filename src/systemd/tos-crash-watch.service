[Unit]
Description=tegendo-os crash watcher (offers AI diagnosis of your crashed apps)

[Service]
ExecStart=/usr/bin/tos-crash-watch
Restart=on-failure
RestartSec=5
# Read-only helper: no new privileges, private /tmp, no writes outside config.
# The "Diagnose" terminal is launched via systemd-run, so it is not confined.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-%h/.config/tegendo-os

[Install]
# default.target rather than graphical-session.target: notifications only need
# the session bus, and not every desktop activates graphical-session.target.
WantedBy=default.target
